# Copie ce fichier en ".env" pour tester le site sur ton ordinateur (npm start).
# Sur Render, NE PAS uploader de fichier .env : ces mêmes valeurs se règlent
# dans l'onglet "Environment" du service, voir README.md.

# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@CLUSTER.mongodb.net/clarakitchenette?retryWrites=true&w=majority

# Mot de passe pour entrer dans l'espace pro du site
ADMIN_PASSCODE=ClaraCuisine2026

# Port local (Render fournit automatiquement le sien, cette valeur ne sert qu'en local)
PORT=3000
